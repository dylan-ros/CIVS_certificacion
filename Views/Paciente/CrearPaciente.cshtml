@model CIVS_certi.Models.Paciente

<h2>Crear Paciente</h2>

@if (TempData["Success"] != null)
{
    <div style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 320px; max-width: 420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<form asp-action="Crear" method="post" class="mt-3">
    <div class="bg-white border rounded-4 shadow-sm p-4">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill" style="background:#e9f7ef; color:#1e7e34; border:1px solid #cfeedd;">
                                Front Office
                            </span>
                            <span class="text-muted small">Pacientes</span>
                        </div>

                        <h2 class="mt-2 mb-1 fw-semibold" style="color:#1e7e34; letter-spacing:.2px;">
                            Crear nuevo paciente
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-3" />

        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 fw-semibold mb-0">Datos personales</h3>
                <span class="text-muted small">Campos obligatorios</span>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PacienteDPI" class="form-label">DPI</label>
                    <input asp-for="PacienteDPI" class="form-control" placeholder="13 dígitos" />
                    <span asp-validation-for="PacienteDPI" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteNombres" class="form-label">Nombres</label>
                    <input asp-for="PacienteNombres" class="form-control" placeholder="Ej. Juan Carlos" />
                    <span asp-validation-for="PacienteNombres" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteApellido" class="form-label">Apellidos</label>
                    <input asp-for="PacienteApellido" class="form-control" placeholder="Ej. Pérez López" />
                    <span asp-validation-for="PacienteApellido" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteNacimiento" class="form-label">Fecha de nacimiento</label>
                    <input asp-for="PacienteNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="PacienteNacimiento" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteEstadoCivil" class="form-label">Estado civil</label>
                    <input asp-for="PacienteEstadoCivil" class="form-control" placeholder="Ej. Soltero/a" />
                    <span asp-validation-for="PacienteEstadoCivil" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="mb-2">
            <h3 class="h6 fw-semibold mb-2">Contacto</h3>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PacienteTelefono" class="form-label">Teléfono</label>
                    <input asp-for="PacienteTelefono" class="form-control" placeholder="+502 ____ ____" />
                    <span asp-validation-for="PacienteTelefono" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteCorreo" class="form-label">Correo electrónico</label>
                    <input asp-for="PacienteCorreo" class="form-control" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="PacienteCorreo" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PacienteDireccion" class="form-label">Dirección</label>
                    <input asp-for="PacienteDireccion" class="form-control" placeholder="Dirección completa" />
                    <span asp-validation-for="PacienteDireccion" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">Guardar Paciente</button>
            <a asp-controller="Paciente" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        setTimeout(function () {
            const alertEl = document.querySelector('.alert.alert-success');
            if (alertEl) {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                bsAlert.close();
            }
        }, 3000);
    </script>
}