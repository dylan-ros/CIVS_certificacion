@model CIVS_certi.Models.Cita

@{
    ViewData["Title"] = "Programar cita";
    var especialidades = ViewBag.Especialidades as List<CIVS_certi.Models.Especialidad> ?? new();
}

@if (TempData["Success"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="position:fixed; top:20px; right:20px; z-index:9999; min-width:320px; max-width:420px;">
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    var errores = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
    if (errores.Any())
    {
        <div class="alert alert-danger mt-3">
            @foreach (var e in errores)
            {
                <div>@e.ErrorMessage</div>
            }
        </div>
    }
}

<style>
    #calendario {
        font-family: 'Segoe UI', system-ui, sans-serif;
