@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CIVS</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CIVS.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-light bg-white border-bottom shadow-sm px-4 py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2"
               asp-area="" asp-controller="Home" asp-action="Index">
                <span class="rounded-3 px-2 py-1 border" style="letter-spacing:1px;">
                    <img src="~/logo-civs.png" class="img-fluid" style="width:50px;" />
                </span>
            </a>

            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-md-inline">
                    @DateTime.Now.ToString("dddd, dd 'de' MMMM",
                                        new System.Globalization.CultureInfo("es-GT"))
                </span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var nombre = User.FindFirst("NombreCompleto")?.Value
                    ?? User.Identity.Name
                    ?? "Usuario";

                    <span class="d-none d-lg-inline small fw-semibold"
                          style="color:#1a5c38;">
                        @nombre
                    </span>

                    <form asp-controller="Auth" asp-action="Logout"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger rounded-pill px-3">
                            Cerrar sesión
                        </button>
                    </form>
                }
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div id="dock-wrapper">
        <div id="dock">

            <!-- Home -->
            <div class="dock-item" data-modulo="home">
                <div class="dock-menu" id="menu-home">
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('home')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
                        <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625c-1.036 0-1.875-.84-1.875-1.875v-6.198c.03-.028.061-.056.091-.086L12 5.43z" />
                    </svg>
                    <span>Inicio</span>
                </div>
            </div>

            <!-- Front Office -->
            <div class="dock-item" data-modulo="frontoffice">
                <div class="dock-menu" id="menu-frontoffice">
                    <a asp-controller="Paciente" asp-action="Index">Consulta pacientes</a>
                    <a asp-controller="Medico" asp-action="Index">Consulta médicos</a>
                    <a asp-controller="Cita" asp-action="Index">Consulta citas</a>
                    <div class="dock-menu-divider"></div>
                    <a asp-controller="Paciente" asp-action="Crear">+ Nuevo paciente</a>
                    <a asp-controller="Cita" asp-action="CrearCitas">+ Nueva cita</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('frontoffice')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.5 6.375a4.125 4.125 0 118.25 0 4.125 4.125 0 01-8.25 0zM14.25 8.625a3.375 3.375 0 116.75 0 3.375 3.375 0 01-6.75 0zM1.5 19.125a7.125 7.125 0 0114.25 0v.003l-.001.119a.75.75 0 01-.363.63 13.067 13.067 0 01-6.761 1.873c-2.472 0-4.786-.684-6.76-1.873a.75.75 0 01-.364-.63l-.001-.122zM17.25 19.128l-.001.144a2.25 2.25 0 01-.233.96 10.088 10.088 0 005.06-1.01.75.75 0 00.42-.643 4.875 4.875 0 00-6.957-4.611 8.586 8.586 0 011.71 5.157v.003z" />
                    </svg>
                    <span>Front Office</span>
                </div>
            </div>

            <!-- Farmacia -->
            <div class="dock-item" data-modulo="farmacia">
                <div class="dock-menu" id="menu-farmacia">
                    <a asp-controller="Medicamento" asp-action="Index">Consulta medicamentos</a>
                    <div class="dock-menu-divider"></div>
                    <a asp-controller="Medicamento" asp-action="CrearMedicamentoInsumo">+ Nuevo medicamento</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('farmacia')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M11.828 2.25c-.916 0-1.699.663-1.85 1.567l-.091.549a.798.798 0 01-.517.608 7.45 7.45 0 00-.478.198.798.798 0 01-.796-.064l-.453-.324a1.875 1.875 0 00-2.416.2l-.243.243a1.875 1.875 0 00-.2 2.416l.324.453a.798.798 0 01.064.796 7.448 7.448 0 00-.198.478.798.798 0 01-.608.517l-.55.092a1.875 1.875 0 00-1.566 1.849v.344c0 .916.663 1.699 1.567 1.85l.549.091c.281.047.508.25.608.517.06.162.127.321.198.478a.798.798 0 01-.064.796l-.324.453a1.875 1.875 0 00.2 2.416l.243.243c.648.648 1.67.733 2.416.2l.453-.324a.798.798 0 01.796-.064c.157.071.316.137.478.198.267.1.47.327.517.608l.092.55c.15.903.932 1.566 1.849 1.566h.344c.916 0 1.699-.663 1.85-1.567l.091-.549a.798.798 0 01.517-.608 7.52 7.52 0 00.478-.198.798.798 0 01.796.064l.453.324a1.875 1.875 0 002.416-.2l.243-.243c.648-.648.733-1.67.2-2.416l-.324-.453a.798.798 0 01-.064-.796c.071-.157.137-.316.198-.478.1-.267.327-.47.608-.517l.55-.091a1.875 1.875 0 001.566-1.85v-.344c0-.916-.663-1.699-1.567-1.85l-.549-.091a.798.798 0 01-.608-.517 7.507 7.507 0 00-.198-.478.798.798 0 01.064-.796l.324-.453a1.875 1.875 0 00-.2-2.416l-.243-.243a1.875 1.875 0 00-2.416-.2l-.453.324a.798.798 0 01-.796.064 7.462 7.462 0 00-.478-.198.798.798 0 01-.608-.517l-.091-.55a1.875 1.875 0 00-1.85-1.566h-.344zM12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"
                              clip-rule="evenodd" />
                    </svg>
                    <span>Farmacia</span>
                </div>
            </div>

            <!-- Laboratorio -->
            <div class="dock-item" data-modulo="laboratorio">
                <div class="dock-menu" id="menu-laboratorio">
                    <a asp-controller="Laboratorio" asp-action="Index">Consulta órdenes</a>
                    <div class="dock-menu-divider"></div>
                    <a asp-controller="Laboratorio" asp-action="CrearOrden">+ Nueva orden</a>
                    <a asp-controller="Laboratorio" asp-action="CrearExamen">+ Nuevo examen</a>
                    <a asp-controller="Laboratorio" asp-action="CrearReceta">+ Nueva receta</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('laboratorio')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M10.5 3.798v5.02a3 3 0 01-.879 2.121l-2.377 2.377a9.845 9.845 0 015.091 1.013 8.315 8.315 0 005.713.636l.285-.071-3.954-3.955a3 3 0 01-.879-2.121v-5.02a23.614 23.614 0 01-3 0zm4.5.138a.75.75 0 00.093-1.495A24.837 24.837 0 0012 2.25a25.048 25.048 0 00-3.093.191A.75.75 0 009 3.936v4.882a1.5 1.5 0 01-.44 1.06l-6.293 6.291c-1.62 1.621-.903 4.475 1.471 4.88 2.686.46 5.447.698 8.262.698 2.816 0 5.576-.239 8.262-.697 2.373-.406 3.092-3.26 1.47-4.881L15.44 9.879A1.5 1.5 0 0115 8.818V4.936z"
                              clip-rule="evenodd" />
                    </svg>
                    <span>Laboratorio</span>
                </div>
            </div>

            <!-- Caja -->
            <div class="dock-item" data-modulo="caja">
                <div class="dock-menu" id="menu-caja">
                    <a asp-controller="CorteCaja" asp-action="Index">Reporte financiero</a>
                    <div class="dock-menu-divider"></div>
                    <a asp-controller="CorteCaja" asp-action="CrearFactura">+ Nueva factura</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('caja')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2.273 5.625A4.483 4.483 0 015.25 4.5h13.5c1.141 0 2.183.425 2.977 1.125A3 3 0 0018.75 3H5.25a3 3 0 00-2.977 2.625zM2.273 8.625A4.483 4.483 0 015.25 7.5h13.5c1.141 0 2.183.425 2.977 1.125A3 3 0 0018.75 6H5.25a3 3 0 00-2.977 2.625zM5.25 9a3 3 0 00-3 3v6a3 3 0 003 3h13.5a3 3 0 003-3v-6a3 3 0 00-3-3H5.25zm.75 6.75a.75.75 0 000 1.5h7.5a.75.75 0 000-1.5H6zm0-3a.75.75 0 000 1.5h3a.75.75 0 000-1.5H6z" />
                    </svg>
                    <span>Caja</span>
                </div>
            </div>

            <!-- Admin -->
            <div class="dock-item" data-modulo="admin">
                <div class="dock-menu" id="menu-admin">
                    <a asp-controller="Admin" asp-action="Index">Panel admin</a>
                    <a asp-controller="Admin" asp-action="Usuarios">Usuarios</a>
                    <div class="dock-menu-divider"></div>
                    <a asp-controller="Admin" asp-action="CrearUsuario">+ Nuevo usuario</a>
                    <a asp-controller="Admin" asp-action="Auditoria">Bitácora</a>
                </div>
                <div class="dock-icon" onclick="toggleMenu('admin')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z"
                              clip-rule="evenodd" />
                    </svg>
                    <span>Admin</span>
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        body {
            padding-bottom: 100px;
        }

        #dock-wrapper {
            position: fixed;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            display: flex;
            justify-content: center;
        }

        #dock {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            background: rgba(255,255,255,.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,.5);
            border-radius: 22px;
            padding: 10px 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,.15), 0 2px 8px rgba(0,0,0,.08), inset 0 1px 0 rgba(255,255,255,.8);
        }

        .dock-item {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .dock-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            transition: transform .2s cubic-bezier(.34,1.56,.64,1);
            transform-origin: bottom center;
            padding: 6px 8px;
            border-radius: 14px;
        }

            .dock-icon svg {
                width: 32px;
                height: 32px;
                color: #1a5c38;
                background: linear-gradient(145deg, #e8f5ee, #d1fae5);
                border-radius: 10px;
                padding: 6px;
                box-shadow: 0 2px 8px rgba(26,92,56,.2);
                transition: all .2s ease;
            }

            .dock-icon span {
                font-size: .62rem;
                font-weight: 600;
                color: #1a5c38;
                letter-spacing: .3px;
                white-space: nowrap;
            }

            .dock-icon:hover {
                transform: scale(1.35) translateY(-6px);
            }

                .dock-icon:hover svg {
                    background: linear-gradient(145deg, #1a5c38, #2d8653);
                    color: #fff;
                    box-shadow: 0 4px 16px rgba(26,92,56,.4);
                }

        .dock-item.activo .dock-icon {
            transform: scale(1.2) translateY(-4px);
        }

            .dock-item.activo .dock-icon svg {
                background: linear-gradient(145deg, #1a5c38, #2d8653);
                color: #fff;
                box-shadow: 0 4px 16px rgba(26,92,56,.4);
            }

            .dock-item.activo .dock-icon::after {
                content: '';
                display: block;
                width: 4px;
                height: 4px;
                background: #1a5c38;
                border-radius: 50%;
                margin-top: 2px;
            }

        .dock-menu {
            position: absolute;
            bottom: calc(100% + 12px);
            left: 50%;
            transform: translateX(-50%) translateY(8px) scale(.95);
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,.6);
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(0,0,0,.15), 0 2px 8px rgba(0,0,0,.08);
            padding: 6px;
            min-width: 200px;
            opacity: 0;
            pointer-events: none;
            transition: all .2s cubic-bezier(.34,1.2,.64,1);
            z-index: 2000;
        }

            .dock-menu::after {
                content: '';
                position: absolute;
                bottom: -6px;
                left: 50%;
                width: 12px;
                height: 12px;
                background: rgba(255,255,255,.92);
                border-right: 1px solid rgba(255,255,255,.6);
                border-bottom: 1px solid rgba(255,255,255,.6);
                transform: translateX(-50%) rotate(45deg);
            }

        .dock-item.activo .dock-menu {
            opacity: 1;
            pointer-events: all;
            transform: translateX(-50%) translateY(0) scale(1);
        }

        .dock-menu a {
            display: block;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: .82rem;
            font-weight: 500;
            color: #1a2e22;
            text-decoration: none;
            transition: background .12s, color .12s;
            white-space: nowrap;
        }

            .dock-menu a:hover {
                background: #e8f5ee;
                color: #1a5c38;
            }

        .dock-menu-divider {
            height: 1px;
            background: #e8f0ec;
            margin: 4px 6px;
        }
    </style>

    <script>
        function toggleMenu(modulo) {
            const item = document.querySelector(`[data-modulo="${modulo}"]`);
            const estaActivo = item.classList.contains('activo');
            document.querySelectorAll('.dock-item').forEach(i => i.classList.remove('activo'));
            if (!estaActivo) item.classList.add('activo');
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('#dock-wrapper')) {
                document.querySelectorAll('.dock-item').forEach(i => i.classList.remove('activo'));
            }
        });
    </script>

</body>
</html>